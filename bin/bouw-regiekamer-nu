#!/usr/bin/env python3
"""
REGIEKAMER NU — één plaat die alleen toont wat op dit moment gemeten is.

Waarom dit bestaat, in één alinea. De publieke cockpit
(rvh-speaking.github.io/stack-dashboard) leest acht bronnen waarvan er drie
VERIFIED_CURRENT zijn; de overige vijf renderen als UNKNOWN en vullen toch een
paneel. Dertien producten melden daar "UNKNOWN — 4 canonieke features · geen
gekoppeld featurebewijs", "Nu actief" meldt UNKNOWN, en het tickerpaneel toont
gebeurtenissen van 17 tot 28 augustus terwijl de levende ticker vandaag om
19:27 nog schreef. Dat is de "te druk en niet correct" die de eigenaar
beschreef: het scherm was druk mét onbewezen vlakken.

De regel van deze plaat is daarom het spiegelbeeld: **een bron die niet
gelezen kan worden krijgt geen paneel.** Geen UNKNOWN-vlakken, geen
plaatsvervangende nullen. Elk paneel draagt zijn bronpad en zijn meetmoment,
en de kop draagt het machinemerk `bronstand` — bewezen=N totaal=N. Zijn die
twee getallen gelijk, dan staat er niets op het scherm dat niet gemeten is.
Dat merk is meteen de acceptatieproef van dit bestand.

Alles wordt inline in de HTML geschreven. Dat is geen slordigheid maar een
eis: de plaat wordt met `open` vanaf de schijf bekeken, en op `file://`
weigert de browser elke `fetch()`. Een plaat die zijn data ophaalt is op die
route per definitie leeg.

Leest uitsluitend; schrijft uitsluitend in ~/regiekamer/nu/. Raakt geen enkel
pad van de autocoding-lane aan.
"""

from __future__ import annotations

import html
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
STACK = Path(os.environ.get("REGIEKAMER_STACK_ROOT", HOME / "Stack-Director"))
REGIEKAMER = Path(os.environ.get("REGIEKAMER_ROOT", HOME / "regiekamer"))
UIT = REGIEKAMER / "nu" / "index.html"

# Hoeveel tickerregels de plaat toont. De bron is append-only en groeit; een
# plaat die alles toont wordt onleesbaar en traag.
TICKER_REGELS = 220


# --------------------------------------------------------------------------
# Meten. Elke lezer geeft (waarde, bron) terug of (None, bron) als er niets
# te meten viel. Nergens een vervangwaarde: dat is precies het defect dat deze
# plaat niet herhaalt.
# --------------------------------------------------------------------------

class Bron:
    """Eén gelezen bron met zijn uitkomst. `bewezen` is waar als er echt iets is."""

    def __init__(self, naam: str, pad: Path):
        self.naam = naam
        self.pad = pad
        self.data = None
        self.fout = None

    @property
    def bewezen(self) -> bool:
        return self.data is not None and self.fout is None

    @property
    def kortpad(self) -> str:
        try:
            return str(self.pad.relative_to(HOME))
        except ValueError:
            return self.pad.name


def lees_json(naam: str, pad: Path) -> Bron:
    b = Bron(naam, pad)
    try:
        b.data = json.loads(pad.read_text(encoding="utf-8"))
    except FileNotFoundError:
        b.fout = "bestand bestaat niet"
    except json.JSONDecodeError:
        b.fout = "geen geldige JSON"
    except OSError:
        b.fout = "niet leesbaar"
    return b


def lees_ticker(pad: Path, maximum: int) -> Bron:
    """
    Append-only JSONL. Regels die niet parsen worden geteld, niet verzwegen en
    niet gerepareerd — een stille reparatie maakt van een defect een cijfer.
    """
    b = Bron("ticker", pad)
    try:
        regels = pad.read_text(encoding="utf-8").splitlines()
    except OSError:
        b.fout = "niet leesbaar"
        return b
    events, stuk = [], 0
    for regel in regels:
        regel = regel.strip()
        if not regel:
            continue
        try:
            events.append(json.loads(regel))
        except json.JSONDecodeError:
            stuk += 1
    if not events:
        b.fout = "geen leesbare gebeurtenissen"
        return b
    events.sort(key=lambda e: str(e.get("tijd", "")), reverse=True)
    b.data = {"events": events[:maximum], "totaal": len(events), "onparseerbaar": stuk}
    return b


# --------------------------------------------------------------------------
# Weergave
# --------------------------------------------------------------------------

def e(x) -> str:
    return html.escape("" if x is None else str(x), quote=True)


def klok(iso: str | None) -> str:
    """`2026-09-05T19:27:41Z` -> `21:27:41` in NL-tijd, of een streepje."""
    if not iso:
        return "—"
    try:
        d = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
    except ValueError:
        return "—"
    return d.astimezone().strftime("%H:%M:%S")


def datumklok(iso: str | None) -> str:
    if not iso:
        return "—"
    try:
        d = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
    except ValueError:
        return "—"
    return d.astimezone().strftime("%d-%m %H:%M")


def leeftijd(iso: str | None) -> str:
    if not iso:
        return "—"
    try:
        d = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
    except ValueError:
        return "—"
    sec = int((datetime.now(timezone.utc) - d).total_seconds())
    if sec < 90:
        return f"{sec}s"
    if sec < 5400:
        return f"{sec // 60}m"
    return f"{sec // 3600}u"


# De statuswoorden die in de bronnen voorkomen, teruggebracht tot drie lampen.
# Alles wat niet herkend wordt krijgt de neutrale lamp — nooit stilzwijgend
# groen, dat was de valse-groen-fout van de oude plaat.
def lamp(status: str | None) -> str:
    s = (status or "").upper()
    if any(k in s for k in ("GEBLOKKEERD", "BLOCKED", "NO_GO", "FAILED", "REJECTED", "ISSUES")):
        return "rood"
    if any(k in s for k in ("BEZIG", "RUNNING", "DISPATCHED")):
        return "amber"
    if any(k in s for k in ("VRIJ", "OK", "GO", "PASS", "DELIVERED", "COMPLETE", "GREEN")):
        return "groen"
    return "grijs"


def paneel(titel: str, bron: Bron, gemeten: str | None, binnenkant: str) -> str:
    """Eén paneel. Wordt alleen aangeroepen voor een bewezen bron."""
    return f"""<section class="paneel">
  <header class="paneel-kop">
    <h2>{e(titel)}</h2>
    <p class="herkomst"><span class="pad">{e(bron.kortpad)}</span><span class="tijd">gemeten {e(gemeten or '—')}</span></p>
  </header>
  {binnenkant}
</section>"""


def ontbreekt(bronnen: list[Bron]) -> str:
    """
    De enige plek waar een niet-gelezen bron zichtbaar is: als regel in de
    voet, niet als leeg paneel. Ontbrekend bewijs hoort vermeld te worden,
    niet uitgestald.
    """
    stuk = [b for b in bronnen if not b.bewezen]
    if not stuk:
        return '<p class="alles-gemeten">Alle bronnen op deze plaat zijn gelezen. Er staat niets op het scherm dat niet gemeten is.</p>'
    rijen = "".join(
        f"<li><span class=\"pad\">{e(b.kortpad)}</span> — {e(b.fout)}</li>" for b in stuk
    )
    return f'<div class="ontbreekt"><h3>Niet gelezen — daarom hierboven geen paneel</h3><ul>{rijen}</ul></div>'


# --------------------------------------------------------------------------
# De panelen
# --------------------------------------------------------------------------

def paneel_ticker(b: Bron) -> str:
    ev = b.data["events"]
    rijen = []
    for x in ev:
        res = x.get("resultaat") or x.get("overgang") or ""
        rijen.append(
            "<tr>"
            f'<td class="t">{e(klok(x.get("tijd")))}</td>'
            f'<td class="k">{e(x.get("kanaal"))}</td>'
            f'<td class="w"><span class="taak">{e(x.get("taak_id"))}</span>'
            f'<span class="overgang">{e(x.get("overgang"))}</span></td>'
            f'<td class="s"><span class="lamp {lamp(res)}"></span>{e(res)}</td>'
            "</tr>"
        )
    meta = (
        f'<p class="tel">{b.data["totaal"]} gebeurtenissen in de bron · '
        f'{len(ev)} getoond'
        + (f' · {b.data["onparseerbaar"]} onparseerbaar' if b.data["onparseerbaar"] else "")
        + "</p>"
    )
    return paneel(
        "Wat er wordt gedaan",
        b,
        klok(ev[0].get("tijd")),
        f"""{meta}
<div class="logvenster">
<table class="log">
<thead><tr><th>Tijd</th><th>Kanaal</th><th>Wat</th><th>Status</th></tr></thead>
<tbody>{''.join(rijen)}</tbody>
</table>
</div>""",
    )


def paneel_lanes(b: Bron) -> str:
    d = b.data
    accounts = d.get("accounts") or []
    rijen = []
    for a in accounts:
        st = a.get("status")
        minuten = a.get("sinds_minuten")
        duur = "—" if minuten is None else (f"{int(minuten)}m" if minuten < 90 else f"{minuten / 60:.1f}u")
        rijen.append(
            "<tr>"
            f'<td class="actor">{e(a.get("actor"))}</td>'
            f'<td class="st"><span class="lamp {lamp(st)}"></span>{e(st)}</td>'
            f'<td class="duur">{e(duur)}</td>'
            f'<td class="taak">{e(a.get("taak_id"))}</td>'
            "</tr>"
        )
    telling = {}
    for a in accounts:
        telling[a.get("status") or "?"] = telling.get(a.get("status") or "?", 0) + 1
    samenvatting = " · ".join(f"{v}× {k.lower()}" for k, v in sorted(telling.items()))
    return paneel(
        "Wie werkt waaraan",
        b,
        klok(d.get("gegenereerd_op")),
        f'<p class="tel">{e(samenvatting)}</p>'
        f'<table class="lanes"><tbody>{"".join(rijen)}</tbody></table>',
    )


def paneel_poort(controller: Bron, supervisor: Bron) -> str:
    """
    De twee cijfers die samen zeggen of de fabriek draait. Ze staan bewust in
    één paneel: los van elkaar zijn ze allebei misleidend. `dispatched=0` bij
    `scanned=8` ziet er rustig uit; pas naast een oplopende supervisorstreak
    is zichtbaar dat het geen rust is maar een klem.
    """
    c, s = controller.data, supervisor.data
    esc = s.get("escalation") or {}
    acties = s.get("actions") or []
    categorie = acties[0].get("category") if acties else None
    detail = acties[0].get("detail") if acties else None
    streak = esc.get("streak")
    drempel = esc.get("threshold")
    klem = isinstance(streak, int) and isinstance(drempel, int) and streak > drempel

    return paneel(
        "Staat de poort open",
        controller,
        klok(c.get("heartbeat")),
        f"""<div class="cijfers">
  <div class="cijfer"><span class="waarde">{e(c.get('scanned'))}</span><span class="etiket">gescand</span></div>
  <div class="cijfer{' alarm' if c.get('dispatched') == 0 else ''}"><span class="waarde">{e(c.get('dispatched'))}</span><span class="etiket">uitgezet</span></div>
  <div class="cijfer"><span class="waarde">{e(c.get('skipped'))}</span><span class="etiket">overgeslagen</span></div>
  <div class="cijfer{' alarm' if klem else ''}"><span class="waarde">{e(streak)}</span><span class="etiket">rondes vast</span></div>
</div>
<p class="duiding">{'De controller kijkt, telt en zet niets uit. De supervisor meldt dat al ' + e(streak) + ' rondes achtereen — bij een drempel van ' + e(drempel) + '. Dit is geen rust maar een klem.' if klem else 'Controller en supervisor melden geen klem.'}</p>
<p class="tel">{e(categorie)}{' · ' + e(detail) if detail else ''} · supervisor gemeten {e(klok(s.get('heartbeat')))} · <span class="pad">{e(supervisor.kortpad)}</span></p>""",
    )


def paneel_beslisrij(b: Bron) -> str:
    d = b.data.get("beslisrij") or {}
    items = d.get("items") or []
    if not items:
        return ""
    rijen = []
    for it in items:
        # De bron is markdown; de vetmarkering hoort niet in een HTML-cel.
        besluit = str(it.get("besluit") or "").replace("**", "")
        rijen.append(
            "<li>"
            f'<span class="nr">{e(it.get("nr"))}</span>'
            f'<span class="besluit">{e(besluit)}</span>'
            f'<span class="kost">{e(it.get("kost"))}</span>'
            f'<span class="ontgrendelt">ontgrendelt: {e(it.get("ontgrendelt"))}</span>'
            "</li>"
        )
    onparseerbaar = d.get("onparseerbaar_count") or 0
    staart = (
        f'<p class="tel">{onparseerbaar} regel(s) in de bron niet te lezen — niet meegeteld.</p>'
        if onparseerbaar
        else ""
    )
    return paneel(
        f"Wacht op Richard ({len(items)})",
        b,
        klok(b.data.get("gegenereerd_op")),
        f'<ol class="beslisrij">{"".join(rijen)}</ol>{staart}',
    )


def paneel_capaciteit(b: Bron) -> str:
    cap = (b.data.get("capaciteit") or {}).get("data") or {}
    lanes = [l for l in (cap.get("lanes") or []) if (l.get("orders") or 0) >= 5]
    if not lanes:
        return ""
    lanes.sort(key=lambda l: l.get("orders") or 0, reverse=True)
    rijen = []
    for l in lanes[:12]:
        geslaagd = l.get("geslaagd_pct") or 0.0
        geblokkeerd = l.get("geblokkeerd_pct") or 0.0
        overig = max(0.0, 100.0 - geslaagd - geblokkeerd)
        rijen.append(
            "<tr>"
            f'<td class="actor">{e(l.get("actor"))}</td>'
            f'<td class="n">{e(l.get("orders"))}</td>'
            '<td class="balk"><span class="staaf">'
            f'<i class="g" style="width:{geslaagd:.1f}%"></i>'
            f'<i class="r" style="width:{geblokkeerd:.1f}%"></i>'
            f'<i class="o" style="width:{overig:.1f}%"></i>'
            "</span></td>"
            f'<td class="pct">{geslaagd:.0f}%</td>'
            f'<td class="laatst">{e(datumklok(l.get("laatste_activiteit")))}</td>'
            "</tr>"
        )
    return paneel(
        "Hoe vaak een lane afmaakt",
        b,
        klok(b.data.get("gegenereerd_op")),
        '<p class="tel">Aandeel orders met een geslaagd verdict. Alleen lanes met minstens 5 orders. '
        '<span class="sleutel"><i class="g"></i>geslaagd <i class="r"></i>geblokkeerd <i class="o"></i>overig</span></p>'
        f'<table class="cap"><tbody>{"".join(rijen)}</tbody></table>',
    )


