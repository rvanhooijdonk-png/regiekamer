.alles-gemeten{margin:0}
.regel{margin:10px 0 0;line-height:1.6}
"""

# De klok is het enige script op de plaat. Hij rekent niets uit dat ook
# gemeten had kunnen worden — hij laat alleen de wandklok en de leeftijd van
# de laatste gebeurtenis oplopen, zodat een stilstaande generator meteen
# zichtbaar is in plaats van als verse plaat door te gaan.
SCRIPT = """
(function(){
  var k=document.getElementById('nu'), o=document.getElementById('ouderdom');
  var t0=Number(document.body.dataset.laatsteEpoch||0);
  function tik(){
    var d=new Date();
    k.textContent=String(d.getHours()).padStart(2,'0')+':'
      +String(d.getMinutes()).padStart(2,'0')+':'
      +String(d.getSeconds()).padStart(2,'0');
    if(t0>0&&o){
      var s=Math.max(0,Math.floor(d.getTime()/1000-t0));
      o.textContent=s<90?s+'s geleden':(s<5400?Math.floor(s/60)+'m geleden':Math.floor(s/3600)+'u geleden');
    }
  }
  tik(); setInterval(tik,1000);
})();
"""


def bouw() -> int:
    ticker = lees_ticker(STACK / "state" / "stack-ticker-events.jsonl", TICKER_REGELS)
    regie = lees_json("regiekamer", REGIEKAMER / "regiekamer.json")
    controller = lees_json("controller", STACK / "state" / "autocoder-controller-heartbeat.json")
    supervisor = lees_json("supervisor", STACK / "state" / "autocoding-supervisor" / "status.json")
    bronnen = [ticker, regie, controller, supervisor]

    links, rechts = [], []
    if ticker.bewezen:
        links.append(paneel_ticker(ticker))
    if controller.bewezen and supervisor.bewezen:
        rechts.append(paneel_poort(controller, supervisor))
    if regie.bewezen:
        rechts.append(paneel_lanes(regie))
        rechts.append(paneel_beslisrij(regie))
        rechts.append(paneel_capaciteit(regie))
    rechts = [p for p in rechts if p]

    if not links and not rechts:
        print("bouw-regiekamer-nu: geen enkele bron leesbaar — geen plaat geschreven", file=sys.stderr)
        return 1

    bewezen = sum(1 for b in bronnen if b.bewezen)
    nu = datetime.now(timezone.utc)
    laatste = ticker.data["events"][0].get("tijd") if ticker.bewezen else None
    try:
        laatste_epoch = int(
            datetime.fromisoformat(str(laatste).replace("Z", "+00:00")).timestamp()
        ) if laatste else 0
    except ValueError:
        laatste_epoch = 0

    doc = f"""<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta name="bronstand" content="bewezen={bewezen} totaal={len(bronnen)}">
<meta name="gebouwd" content="{nu.isoformat().replace('+00:00', 'Z')}">
<meta http-equiv="refresh" content="60">
<title>Regiekamer nu</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>{STIJL}</style>
</head>
<body data-laatste-epoch="{laatste_epoch}">
<div class="wrap">
<div class="kop">
  <h1>Regiekamer</h1>
  <span class="nu" id="nu">--:--:--</span>
  <span class="merk">laatste gebeurtenis <span id="ouderdom">{e(leeftijd(laatste))}</span> · plaat gebouwd {e(klok(nu.isoformat()))} · ververst elke 60 s · bronstand <b>bewezen={bewezen}</b> totaal={len(bronnen)}</span>
</div>
<div class="rooster">
  <div class="kolom">{''.join(links)}</div>
  <div class="kolom">{''.join(rechts)}</div>
</div>
<div class="voet">
  {ontbreekt(bronnen)}
  <p class="regel">Deze plaat toont uitsluitend bronnen die bij deze bouw gelezen zijn. Een bron die niet gelezen kon worden krijgt geen paneel maar een regel hierboven — er staat dus nooit een vlak op het scherm dat een meting suggereert die niet bestaat. De klok linksboven loopt in de browser; het bouwmoment ernaast niet. Lopen die twee ver uiteen, dan staat de generator stil en is de plaat oud, hoe vers hij er ook uitziet.</p>
</div>
</div>
<script>{SCRIPT}</script>
</body>
</html>
"""

    UIT.parent.mkdir(parents=True, exist_ok=True)
    UIT.write_text(doc, encoding="utf-8")
    print(f"{UIT} · bronstand bewezen={bewezen} totaal={len(bronnen)}")
    return 0


if __name__ == "__main__":
    sys.exit(bouw())
